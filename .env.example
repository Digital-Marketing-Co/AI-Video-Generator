# PUBLIC
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SERVER
APP_ENV=development
SUPER_ADMIN_EMAILS=
FEATURE_PUBLIC_SIGNUP=false
FEATURE_PAID_SUBSCRIPTIONS=false
FEATURE_CUSTOMER_CREDIT_BILLING=false
FEATURE_SUPER_ADMIN_GENERATION=true

# DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# AUTHENTICATION
AUTH_SECRET=replace-with-long-random-secret

# AI PROVIDERS
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai

# STORAGE
BLOB_READ_WRITE_TOKEN=

# BILLING
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OBSERVABILITY
LOG_LEVEL=info
